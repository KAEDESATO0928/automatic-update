Windows Registry Editor Version 5.00

; apclo-sonet:// URLスキーム登録
; ダブルクリックして「はい」で実行（HKCU配下なので管理者権限不要）
;
; sonet-rpa.bat 経由で main.py を起動（Microsoft Store版 Python の sandbox 対策）

[HKEY_CURRENT_USER\Software\Classes\apclo-sonet]
@="URL:apclo Sonet RPA Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\apclo-sonet\shell]

[HKEY_CURRENT_USER\Software\Classes\apclo-sonet\shell\open]

[HKEY_CURRENT_USER\Software\Classes\apclo-sonet\shell\open\command]
@="\"C:\\AUTOET\\automatic-update\\sonet-rpa.bat\" \"%1\""
